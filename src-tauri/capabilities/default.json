{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the Projectradar main window. Filesystem scope is dynamic — we add the user-chosen projectroot at runtime.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "dialog:default",
    "dialog:allow-open",
    "store:default",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:scope-appdata-recursive",
    "fs:scope-appconfig-recursive",
    "fs:scope-document-recursive",
    "fs:scope-home-recursive",
    "fs:scope-desktop-recursive",
    "fs:scope-resource-recursive"
  ]
}

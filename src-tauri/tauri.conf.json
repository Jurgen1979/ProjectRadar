{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Projectradar",
  "version": "1.1.0",
  "identifier": "app.projectradar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:static",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Projectradar",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../examples/denkmachine-demo/**/*"],
    "category": "Productivity",
    "shortDescription": "Local-first projectdashboard",
    "longDescription": "Projectradar is a local-first project dashboard for people who keep their work spread across AI chats, local folders, drives, mail labels, code repos, and design files."
  }
}

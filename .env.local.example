# Projectradar v1 — lokale configuratie
# Kopieer dit bestand naar .env.local en pas de waarden aan.

# Absoluut pad naar de map die /projects (en optioneel projectradar.config.json) bevat.
# Voorbeeld: /Users/jouwnaam/Projectradar
PROJECTRADAR_ROOT=

# -----------------------------------------------------------------------------
# AI — optioneel. Laat alles leeg om de app zonder AI te draaien.
# Aanbevolen: OpenRouter, zodat je makkelijk tussen modellen kunt wisselen
# (Anthropic, OpenAI, Mistral, lokale modellen via OpenRouter, …).
# Alternatief: rechtstreeks OpenAI.
# -----------------------------------------------------------------------------

# Provider keuze: openrouter | openai | none
AI_PROVIDER=none

# Modelnaam afhankelijk van provider. Voorbeelden:
#   openrouter: anthropic/claude-sonnet-4-6, openai/gpt-4o-mini, google/gemini-2.5-pro
#   openai:     gpt-4o-mini, gpt-4o, o3-mini
AI_MODEL=

# API keys — alleen de key invullen die past bij AI_PROVIDER.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# OpenRouter herkenning (optioneel) — verschijnen in je OpenRouter-dashboard.
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# Geavanceerd (zelden nodig): overschrijf de provider-baseURL.
# AI_BASE_URL=
